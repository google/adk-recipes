# Copy as .env file and fill your values below

# Choose 1 for Gemini Vertex AI or 0 Gemini Developer API 
GOOGLE_GENAI_USE_VERTEXAI=1

GOOGLE_API_KEY=<TODO: update-this-value> # Required if GOOGLE_GENAI_USE_VERTEXAI=0.

# Vertex backend config
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
GOOGLE_CLOUD_LOCATION=global

# Your Model Armor template in your Google Cloud project.
MODEL_ARMOR_TEMPLATE_ID=<TODO: update-this-value>
# Model Armor uses a regional endpoint independently from Gemini.
GOOGLE_CLOUD_MODEL_ARMOR_LOCATION=us-central1
# Optional: use a different project for Model Armor.
GOOGLE_CLOUD_MODEL_ARMOR_PROJECT=
MODEL_ARMOR_TIMEOUT_S=5

# Renamed from hardcoded string in source. Rename the variable if needed.
MODEL_NAME_GENERATED_1=gemini-3.5-flash
MODEL_NAME_GENERATED_2=gemini-3.1-flash-lite
