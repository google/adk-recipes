# Every environment variable the code reads, with its default value.
# For local runs, copy config.env.example to config.env and edit that file:
# the package loads config.env at import. This file is the full reference.
# For the PROJECT_ID, GENMEDIA_* and web app settings an empty value means
# "not set" and the default applies.

# --- Google Cloud ---
# Project used for Vertex AI, Cloud Storage and Cloud Vision (required).
PROJECT_ID=your-gcp-project-id
# Fallback when PROJECT_ID is not set. The agent sets it from PROJECT_ID when
# it is unset, because the Gemini SDK used by the agent reads it.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Region for Gemini calls. "global" routes to the nearest region.
GLOBAL_REGION=global
# Region for services that are regional only (embeddings), and of the Cloud
# Run service (make deploy, make register-gemini-enterprise).
DEFAULT_REGION=us-central1
# Region of the agent's own model calls, read by the Gemini SDK. The agent
# sets it from GLOBAL_REGION when it loads (a value set here is replaced).
GOOGLE_CLOUD_LOCATION=global
# Read by the Gemini SDK used by the agent. Default: False when GOOGLE_API_KEY
# is set, else True.
GOOGLE_GENAI_USE_VERTEXAI=True
# Set to send Gemini calls through the Gemini API (AI Studio) instead of Vertex AI.
GOOGLE_API_KEY=
# Bucket for user uploads, generated media, the agent's conversations and the
# Studio's state and jobs (sessions/).
# Default: <PROJECT_ID>-genmedia-for-commerce-media-payloads
MEDIA_BUCKET=
# Each request is a run with one folder in MEDIA_BUCKET:
# runs/<date>/<session_id>/<run_id>/. Terraform deletes objects under runs/
# and sessions/ 30 days after their last write (media_retention_days).
# Where input images go: inline = only in the request; gcs = also saved
# under the run's inputs/. Each request can override it (input=inline|gcs).
GENMEDIA_INPUT=inline
# Where generated images and videos go: inline = base64 in the response;
# gcs = saved under the run's outputs/, the response carries links.
# Each request can override it (output=inline|gcs).
GENMEDIA_OUTPUT=inline

# --- Models ---
GENMEDIA_TEXT_MODEL=gemini-3.8-flash
GENMEDIA_TEXT_LITE_MODEL=gemini-3.5-flash-lite
GENMEDIA_JUDGE_MODEL=gemini-4-argon
GENMEDIA_STUDIO_AGENT_MODEL=gemini-4-argon
GENMEDIA_IMAGE_MODEL=gemini-nano-banana-2.1
GENMEDIA_VIDEO_MODEL=gemini-omni-1.1-flash-preview
# Api-Revision header sent with video generation requests.
GENMEDIA_VIDEO_API_REVISION=2026-05-20
# Must match the model that built the catalogue embeddings.
GENMEDIA_EMBED_CATALOG_MODEL=gemini-embedding-001

# --- Generation defaults (each request can override them) ---
# parallel = all variations at once; sequential = one at a time, stop at the first good one.
GENMEDIA_RUN_MODE=parallel
# Variations per request, 1 to 5.
GENMEDIA_NUM_VARIATIONS=3
# Attempts in sequential mode, 1 to 10.
GENMEDIA_MAX_ATTEMPTS=5
# Video Try-On: videos of each animated try-on image, 1 to 5.
GENMEDIA_VIDEOS_PER_IMAGE=2
# true = add up to two close-up references of small details (lettering, logos) to non-shoe spins.
GENMEDIA_SPIN_CLOSEUPS=true
# true = search the product photos for small details (logos, lettering,
# hardware) and send them as close-ups with the photo try-on.
GENMEDIA_TRYON_CLOSEUPS=true
# true = keep each photo try-on's preprocessing of the product photos only
# (the products' classification, look-photo crops, close-ups and styling
# plan) in the media bucket (product_cache/, deleted after 30 days) and reuse
# it for the same photos and options.
GENMEDIA_USE_CACHE=true
# true = upscale the wearer's face crop sent with the photo try-on prompt to 2K
# with the image model (one more call per new person photo; skipped when the
# crop is already 1024 px or more on its shorter side). The judge still sees
# the original photo's crop.
GENMEDIA_UPSCALE_FACE=false
# true = a try-on image the judge rejects gets one fix attempt: the image model
# gets it back with the judge's defects, the person's photo and the images of
# the products named, and the fixed image is judged again (it replaces the
# image only when it passes; the result then says fixed: true).
GENMEDIA_TRYON_FIX=false
# Brand styling rules added to every try-on, e.g. "jackets closed, shirts tucked".
GENMEDIA_STYLE_GUIDELINES=
GENMEDIA_SCENARIO=a plain light grey studio environment
# Hosts that https:// image URLs may point to (comma-separated).
GENMEDIA_ALLOWED_IMAGE_HOSTS=storage.googleapis.com,storage.cloud.google.com

# --- Local files ---
# The product catalogue file. Default: <repo>/assets/catalog/products.parquet
GENMEDIA_CATALOG_PATH=
# Local folder for debug traces: every intermediate result of each run, under
# <folder>/<YYYY-MM-DD>/<run_id>/ (see "Debugging a run" in the README).
# Empty = off.
GENMEDIA_DEBUG_DIR=

# --- Web app and agent ---
# Other origins whose browser calls are allowed (CORS), comma-separated
# https://host[:port], or regex:<pattern> for a pattern the whole origin must
# match (no comma in it). Empty = the app's own origin only; "*" is refused at
# startup. config.env.example sets http://localhost:8080,http://127.0.0.1:8080
# (gcloud run services proxy --port 8080, make web) and a regex: entry for
# Cloud Shell's Web Preview of port 8080 (https://8080-<instance>.cloudshell.dev);
# make run-backend (and make dev) sets http://localhost:3000,http://127.0.0.1:3000.
ALLOW_ORIGINS=
# Studio generation starts per studio per rolling hour (one generation runs
# at a time in a studio), and per server instance per rolling hour.
GENMEDIA_MAX_JOBS_PER_HOUR=20
GENMEDIA_MAX_JOBS_PER_INSTANCE_HOUR=100
# Bucket name (without gs://) for the ADK API's artifacts and telemetry. Empty = in-memory artifacts, no telemetry upload.
LOGS_BUCKET_NAME=
# ADK API session store, e.g. a database URL. Empty = studio://, the
# sessions in MEDIA_BUCKET (sessions/studio-<id>/adk/). The Studio panel's
# conversations are kept in MEDIA_BUCKET either way.
SESSION_SERVICE_URI=
# Set by Cloud Run (the service name): the app then serves on 0.0.0.0. Leave
# it empty locally.
K_SERVICE=

# --- Telemetry ---
# false = ADK's trace spans leave out prompts and replies (user photos and
# chats included). The app sets false when this is unset; ADK's own default
# would record them.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
# The rest of this section is used only when LOGS_BUCKET_NAME is set.
COMMIT_SHA=dev
GENAI_TELEMETRY_PATH=completions
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_RESOURCE_ATTRIBUTES=service.namespace=genmedia-for-commerce,service.version=dev
OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://your-logs-bucket/completions

# --- Deploy and Gemini Enterprise registration (read by make, not by the app) ---
# Cloud Run service name, used by make deploy and
# make register-gemini-enterprise. Sizing: see config.env.example.
SERVICE_NAME=genmedia-for-commerce
# true = make deploy also puts IAP in front of the service (IAM is always on);
# make register-gemini-enterprise warns, as Gemini Enterprise cannot pass IAP.
USE_IAP=false
# Optional, make register-gemini-enterprise only: an existing Gemini Enterprise
# app to add the Studio to, as the full resource name
# projects/<project>/locations/<location>/collections/default_collection/engines/<id>
# or just <id>. Empty = create or reuse the command's own app, GenMedia Studio
# (id <SERVICE_NAME>-studio). The API cannot add the first data store to an app
# that has none: the command then guides you through the console step.
GEMINI_ENTERPRISE_APP_ID=
# Same as GEMINI_ENTERPRISE_APP_ID (read when that one is empty).
ID=
# Location of the Gemini Enterprise app (its own app, or GEMINI_ENTERPRISE_APP_ID
# when that is just an id).
GEMINI_ENTERPRISE_LOCATION=global

# --- Tests ---
# 1 = run the tests in tests/live against real Google APIs (costs money).
GENMEDIA_LIVE=

# Web app dev server (make run-frontend): the backend its /api calls go to.
# Unset: http://localhost:8000.
# VITE_API_TARGET=http://localhost:8000
