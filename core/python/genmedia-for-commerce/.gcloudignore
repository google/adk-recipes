#!include:.gitignore

.git/
.gitignore
.DS_Store
Thumbs.db
*.log

__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

.ruff_cache/

# ADK runtime session/artifact storage — created on first agent import
.adk/
**/.adk/

.venv/
**/.venv/
venv/

node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/

# Assets stay local, except the product catalogue the image copies in
/assets/*
!/assets/catalog/

# Local debug dumps and eval clips
**/debug*/
**/video_examples/
*.zip
