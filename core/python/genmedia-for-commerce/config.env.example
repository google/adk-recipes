# GCP Configuration
PROJECT_ID=your-gcp-project-id

# Regions
GLOBAL_REGION=global
US_REGION=us-central1
EUROPE_REGION=europe-west4
DEFAULT_REGION=us-central1

# Cloud Run Deployment
SERVICE_NAME=genmedia-for-commerce
IMAGE_NAME=gcr.io/your-gcp-project-id/genmedia-for-commerce
MEMORY=32Gi
CPU=8
TIMEOUT=3600
CONCURRENCY=7
MAX_INSTANCES=10
MIN_INSTANCES=2

# Cloud Run authentication (IAM is always on, IAP is optional)
USE_IAP=false

# Catalog Search
EMBEDDING_MODEL=gemini-embedding-001

# Shoe Classifier
# Remote fine-tuned endpoint (None = use local embedding-based classifier)
SHOE_CLASSIFICATION_ENDPOINT=None
MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-2-preview

# Models (read via os.getenv("MODEL_NAME_GENERATED_*") by the agent and the
# MCP tools; must be set here because the runtime only loads config.env).
# 1/4 = flash, 2 = flash-lite, 3 = pro, 5 = image, 6/7 = embedding,
# 8 = upscale.
MODEL_NAME_GENERATED_1=gemini-3.8-flash
MODEL_NAME_GENERATED_2=gemini-3.5-flash-lite
MODEL_NAME_GENERATED_3=gemini-3.1-pro-preview
MODEL_NAME_GENERATED_4=gemini-3.8-flash
MODEL_NAME_GENERATED_5=gemini-nano-banana-2.1
MODEL_NAME_GENERATED_6=gemini-embedding-001
MODEL_NAME_GENERATED_7=gemini-embedding-2-preview
MODEL_NAME_GENERATED_8=None

