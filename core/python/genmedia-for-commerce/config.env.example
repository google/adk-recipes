# Copy to config.env and edit it. When config.env is missing, the make targets
# that need it (setup-infra, deploy...) create it from this file with PROJECT_ID
# set to the gcloud project. The package loads it with python-dotenv.
# make deploy passes every
# non-empty value below to the Cloud Run service as an env var (quotes and
# inline comments are stripped). Keys ending in _KEY, _SECRET, _TOKEN,
# _PASSWORD or _CREDENTIALS (e.g. GOOGLE_API_KEY) are never deployed (it warns
# with their names); pass them from Secret Manager with
# SECRETS="KEY=SECRET_ID:latest".

# GCP Configuration
PROJECT_ID=your-gcp-project-id
# Set to use AI Studio instead of Vertex AI (local only; deploy via SECRETS=)
# GOOGLE_API_KEY=

# Regions
GLOBAL_REGION=global
DEFAULT_REGION=us-central1

# Cloud Run service (make deploy): one service runs the REST API, the
# web app, the ADK API and the Studio MCP App for Gemini Enterprise (/mcp).
# Sizing is set only here. CPU is always allocated (Studio generations run in
# the background), so MIN_INSTANCES instances are billed all the time.
SERVICE_NAME=genmedia-for-commerce
MEMORY=32Gi
CPU=8
TIMEOUT=3600
CONCURRENCY=7
MAX_INSTANCES=10
MIN_INSTANCES=2

# Cloud Run authentication: IAM is always on; true also puts IAP in front
USE_IAP=false

# Browser origins allowed besides the app's own (comma-separated, "*" is
# refused): those of `gcloud run services proxy ... --port 8080` (make web),
# which opens the deployed app at http://localhost:8080, and Cloud Shell's
# Web Preview of port 8080 (https://8080-<instance>.cloudshell.dev): a regex:
# entry is a pattern the whole origin must match. Add yours if you proxy on
# another port; empty = the app's own origin only. make dev uses the Vite dev
# server's.
ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,regex:^https://8080-[a-z0-9.-]+\.cloudshell\.dev$

# make register-gemini-enterprise creates its own Gemini Enterprise app,
# GenMedia Studio (id <SERVICE_NAME>-studio, in GEMINI_ENTERPRISE_LOCATION).
# Optional: add the Studio to an existing app instead, as
# projects/<number>/locations/<location>/collections/default_collection/engines/<id>
# or just <id> in GEMINI_ENTERPRISE_LOCATION (default global)
# GEMINI_ENTERPRISE_APP_ID=
# GEMINI_ENTERPRISE_LOCATION=global

# Models (defaults shown; uncomment to override)
# GENMEDIA_TEXT_MODEL=gemini-3.8-flash
# GENMEDIA_TEXT_LITE_MODEL=gemini-3.5-flash-lite
# GENMEDIA_JUDGE_MODEL=gemini-4-argon
# GENMEDIA_STUDIO_AGENT_MODEL=gemini-4-argon
# GENMEDIA_IMAGE_MODEL=gemini-nano-banana-2.1
# GENMEDIA_VIDEO_MODEL=gemini-omni-1.1-flash-preview
# GENMEDIA_VIDEO_API_REVISION=2026-05-20
# GENMEDIA_EMBED_CATALOG_MODEL=gemini-embedding-001

# Runtime settings (defaults shown; uncomment to override)
# MEDIA_BUCKET=<PROJECT_ID>-genmedia-for-commerce-media-payloads
# Where input images go: inline (default, only in the request) or gcs (also
# saved under runs/<date>/<session>/<run>/inputs/ in MEDIA_BUCKET); gcs is
# recommended for Cloud Run
# GENMEDIA_INPUT=gcs
# Where results go: inline (default, base64 in the response) or gcs (saved
# under runs/<date>/<session>/<run>/outputs/ in MEDIA_BUCKET, links in the
# response); gcs is recommended for Cloud Run
# GENMEDIA_OUTPUT=gcs
# The product catalogue file (products, preset models, spin sets)
# GENMEDIA_CATALOG_PATH=<repo root>/assets/catalog/products.parquet
# Local folder for debug traces of every run (<folder>/<YYYY-MM-DD>/<run_id>/);
# unset = off. On Cloud Run use /tmp, and only for a short investigation.
# GENMEDIA_DEBUG_DIR=
# GENMEDIA_STYLE_GUIDELINES=
# GENMEDIA_SCENARIO=a plain light grey studio environment
# Comma-separated
# GENMEDIA_ALLOWED_IMAGE_HOSTS=storage.googleapis.com,storage.cloud.google.com
# GENMEDIA_RUN_MODE=parallel
# GENMEDIA_NUM_VARIATIONS=3
# GENMEDIA_MAX_ATTEMPTS=5
# Photo try-on: one fix attempt for each image the judge rejects
# GENMEDIA_TRYON_FIX=false
# Video Try-On: videos of each animated try-on image
# GENMEDIA_VIDEOS_PER_IMAGE=2
# Studio generation starts per studio per rolling hour, and per server
# instance per rolling hour (one generation runs at a time in a studio)
# GENMEDIA_MAX_JOBS_PER_HOUR=20
# GENMEDIA_MAX_JOBS_PER_INSTANCE_HOUR=100
