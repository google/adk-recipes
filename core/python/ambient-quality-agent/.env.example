# Local-run configuration template for the Ambient Quality Agent (AQuA).
#
# Setup:
# 1. Copy template to the agent package: `cp .env.example src/ambient_quality_agent/.env`
# 2. Populate environment variables.
#
# ADK's `load_dotenv_for_agent` searches upward from the package directory
# (`src/ambient_quality_agent`) for `.env`. Shell variables take precedence over `.env`.
#
# Committed template; do not store secrets here (`.env` is gitignored).

# --- Standalone (`make standalone`) ---
# Runs AQuA against your own deployed agent with nothing of AQuA's deployed.
# `make standalone` sets AQA_STANDALONE=1 itself; set it here only to run the
# agent some other way. docs/index.md ("Run AQuA standalone") has the steps.
#
# What a standalone run reads from this file:
#   - the observed agent and GOOGLE_CLOUD_PROJECT, below;
#   - the telemetry source, dataset, table and location, further down;
#   - the models and the run sizing. Keep DATA_EVALUATION_CAP small.
#
# What it ignores, and logs that it ignored: AQA_JOBS_GCS_BUCKET,
# AQA_TRACES_GCS_BUCKET, AQA_DELAY_TASK_QUEUE and AQA_AMBIENT_CALLER_SA.
# AQA_DATASET and AQA_DATASET_LOCATION are not used either.
#
# Runs, insights and conversations live in the agent process and end with it.
# The goal, the memories and the attached agent's configuration are files
# under .aqua/job/ in the working directory, and outlive it.
#
# Your ADC needs read access to the observed agent's telemetry dataset. For the
# cloud_ops and cloud_logging sources it also needs read access to the bucket
# the rows point into, or every conversation arrives empty.
# Set to 1 or true to run standalone; empty defaults to standard execution.
AQA_STANDALONE=

# --- Observed agent (required) ---
# Must match the observed agent's code-level Agent(name=...) value, which is
# the `agent` column in the BigQuery analytics table.
AQA_OBSERVED_AGENT_NAME=your_observed_agent_name

# --- GCP project / location (required) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# Google Cloud region for the evaluation client and the Agent Runtime agent,
# and the fallback region for BigQuery. MUST be a real region (e.g. us-central1),
# NOT a multi-region like US (Eval rejects US). The LLM roles below each carry
# their own region and do NOT use this value.
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model backend ---
# Use the Gemini platform backend (requires ADC). Without this, ADK falls back to the
# Gemini API and needs GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- LLM models (model + serving location) ---
# AQA uses three model groups, each with its own Google Cloud region, independent of
# GOOGLE_CLOUD_LOCATION. Set both the *_MODEL and *_LOCATION together when
# overriding; make sure the model is available in the chosen region.
#   base: orchestrator and dashboard chat
AQA_BASE_MODEL=gemini-3.8-flash
AQA_BASE_LOCATION=global
#   insights: failed-rubric clustering (a reasoning model; runs once per sweep)
AQA_INSIGHTS_MODEL=gemini-3.1-pro-preview
AQA_INSIGHTS_LOCATION=global
#   verification: cluster verification, one call per candidate; runs only when
#   the verification pass below is on
AQA_VERIFICATION_MODEL=gemini-3.7-flash
AQA_VERIFICATION_LOCATION=global

# --- Insight correlation ---
# insight_correlation clusters the sweep's failed rubrics and correlates them
# into the durable insight store on every run.
# BigQuery dataset housing AQA tables (insights and insight_occurrences).
# Provisioned by Terraform or created manually via extension/README.md.
AQA_DATASET=aqua_insights
# BigQuery location of that dataset.
AQA_DATASET_LOCATION=us-central1
# Model the same-issue judge runs on: it decides which existing insight, if any,
# a candidate restates. A `generateContent` call, so it is not pinned to the
# dataset's region.
AQA_INSIGHTS_MATCH_MODEL=gemini-3.5-flash-lite
# Model executed by AI.IF selector queries, with the caller's own credentials.
# A lightweight model is recommended to minimize per-row scanning costs.
AQA_SELECTOR_AI_MODEL=gemini-3.5-flash-lite
# Resolve an insight after this many days without a sighting; 0 disables it.
AQA_INSIGHTS_AUTO_RESOLVE_DAYS=14
# How a sweep judges quality: session_review reviews each session with one LLM
# call, eval_service scores it against eval metrics in Gemini platform.
AQA_QUALITY_ANALYSIS_MODE=session_review
# Check each candidate issue against its own traces before it becomes an
# insight: one model call per candidate, and the sweep's most expensive step.
# It writes the description and the label a reader acts on, so it is on under
# every analysis mode. Set this to 0 to take the pass out of a deployment while
# something else is investigated.
# AQA_INSIGHTS_VERIFICATION_ENABLED=0
# Let a negative verdict withhold the candidate instead of being recorded
# against it. Off by default: a trace that omits the tool error the defect
# turns on reads as no defect, and the candidate would be dropped. Set this to
# 1 where the traces carry full tool errors.
# AQA_INSIGHTS_VERIFICATION_ENFORCED=1
# --- Durable investigations (Agent Runtime deploy only) ---
# Investigations run as durable long-running query jobs the agent submits
# against ITSELF (run_query_job / :asyncQuery). On Agent Runtime these are
# auto-injected; you do not set them locally:
#   GOOGLE_CLOUD_AGENT_ENGINE_ID  -- this engine's own id (self-query target).
# GCS bucket for durable job input/output (set at deploy time):
AQA_JOBS_GCS_BUCKET=your-gcp-project-aqua-jobs
# A job that dies before writing anything leaves its run `pending` for good.
# Set this to have the next submission fail a run left pending that many
# minutes; off by default, and 30 is the value to set.
# AQA_PENDING_RUN_LEASE_MINUTES=30

# --- AQuA's own spans ---
# GCS bucket for exporting OTLP execution spans to support run replays.
# Empty defaults to AQA_JOBS_GCS_BUCKET; set only to store spans in a dedicated bucket.
AQA_TRACES_GCS_BUCKET=
#
# OpenTelemetry GenAI content capture mode (NO_CONTENT, EVENT_ONLY, SPAN_ONLY,
# SPAN_AND_EVENT). Set to SPAN_ONLY during host runs to record conversation turns.
# Empty defaults to NO_CONTENT. Note: loading empty into container environments
# overrides the container image default (SPAN_ONLY).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=

# --- Telemetry source selection ---
# Where AQA reads telemetry from: `big_query` (the ADK analytics plugin),
# `cloud_ops` (a Cloud Trace linked BigQuery dataset), or `cloud_logging`
# (a Cloud Logging GenAI export sink table, as produced by agents-cli).
# Defaults to big_query.
TELEMETRY_INGESTION_SOURCE=big_query

# --- Telemetry dataset and table (all three sources) ---
# One dataset and table, whichever source is selected above.
#
# big_query: the dataset and events table the ADK BigQueryAgentAnalyticsPlugin
# populates on the observed agent. Both default to these values.
AQA_TELEMETRY_DATASET=agent_analytics
AQA_TELEMETRY_TABLE=agent_events
#
# cloud_ops: the linked dataset and view that mirror Cloud Trace spans into
# BigQuery. The dataset is required; the table defaults to _AllSpans.
# AQA_TELEMETRY_DATASET=trace_spans_linked
# AQA_TELEMETRY_TABLE=_AllSpans
#
# cloud_logging: the dataset a Cloud Logging sink populates and the table the
# observed agent's own telemetry.tf created, which `bq ls <dataset>` will
# show.
# Note: message content is offloaded to GCS refs, and raising tool errors are
# NOT captured by this source (they land only in uncorrelated stderr logs).
# AQA_TELEMETRY_DATASET=your_agent_telemetry
# AQA_TELEMETRY_TABLE=aiplatform_googleapis_com_reasoning_engine_stdout

# BigQuery location of that dataset (e.g. US, EU, us-central1). Set it when
# the dataset's region differs from GOOGLE_CLOUD_LOCATION, which it otherwise
# defaults to.
AQA_TELEMETRY_LOCATION=us-central1

# --- Evaluation metrics (comma-separated) ---
# Multi-turn options: task_success, tool_use_quality, trajectory_quality
MULTI_TURN_METRICS=task_success
# Single-turn options: safety (and others, depending on the eval models)
SINGLE_TURN_METRICS=safety

# --- Run sizing ---
# Max records pulled per evaluation run (clamped to <= 1000).
DATA_EVALUATION_CAP=10
# How many days of telemetry to consider (clamped to <= 64).
DATA_LOOKBACK_WINDOW=30

# --- Ambient triggering (Phase 2) ---
# Seconds to wait after an observed-agent update before investigating
# (0 = investigate immediately); lets new-revision traces accumulate first.
AQA_AGENT_REVISION_TRIGGER_DELAY_SECONDS=0
# Ambient investigation window / schedule cadence, in seconds; consecutive
# windows tile without overlap (e.g. 1800 => a 30-minute window). 0 falls back
# to the day-based DATA_LOOKBACK_WINDOW.
# Update-path delayed trigger wiring (deploy-time infra; both vars below --
# plus the auto-injected reasoning-engine id -- required for the update path to
# enqueue; unset means an `update` trigger is a no-op).
# Full Cloud Tasks queue path the delayed trigger task is enqueued into.
AQA_DELAY_TASK_QUEUE=projects/your-gcp-project/locations/us-central1/queues/your-queue
# Service-account email the Cloud Task uses to OAuth-authenticate its call to the
# engine's trigger route.
AQA_AMBIENT_CALLER_SA=your-caller@your-gcp-project.iam.gserviceaccount.com

# Pub/Sub topic an attached agent's update sink publishes to; `aqua attach
# --apply` wires the agent's triggers from it. Leave empty when this deployment
# runs its observed agent's triggers itself.
AQA_AMBIENT_TOPIC=

# Quality analysis mode: session_review | eval_service
AQA_QUALITY_ANALYSIS_MODE=session_review

# Every metric published here joins the session-review sweep. Leave it unset,
# or publish nothing, and session review runs on its own.
# Bucket contents execute with AQuA's credentials; write access equals deploy access.
AQA_METRICS_GCS_BUCKET=

# --- Optional agent settings ---
# Region for AQuA's Agent Runtime when executing durable query jobs. Empty defaults
# to GOOGLE_CLOUD_LOCATION (or the regional default if set to `global`).
AQA_ENGINE_LOCATION=
# GCS bucket holding observed agent source code snapshots keyed by deployment
# revision. When empty, root-cause analyses cannot reference source line numbers.
AQA_SOURCE_GCS_BUCKET=
# Set to 1 or true to execute investigations inline instead of background durable
# query jobs (for local development; enabled automatically in standalone mode).
AQA_SYNC_INVESTIGATION=
# URI for ADK session storage. Empty defaults to Agent Runtime managed sessions
# in production and in-memory sessions for local runs.
SESSION_SERVICE_URI=

# --- Injected by runtime platform (leave empty locally) ---
# Injected by Agent Runtime for engine instance identity and region. Maintain
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION matching GOOGLE_CLOUD_LOCATION; an empty value
# disables ADK location fallback.
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
# Injected by `agents-cli deploy`: public base URL advertised in the A2A agent
# card, and project version (defaults to 0.0.0; unresolved values use package version
# in spans, but the A2A agent card shows 0.0.0, where unset shows 0.1.0).
APP_URL=
AGENT_VERSION=0.0.0
# Injected by Cloud Run Jobs indicating task retry count; empty represents initial run.
CLOUD_RUN_TASK_ATTEMPT=

# --- Client configurations (`agents-cli aqua`, dashboard, and tools) ---
# Read by external tools communicating with AQuA; export these in caller shells
# rather than configuring them here.
# Target deployed agent, specified by resource name or direct endpoint URL:
AGENT_ENGINE_RESOURCE_ID=
AGENT_ENGINE_URL=
# Local agent server (`ambient_quality_agent.fast_api_app`) base URL (default:
# http://localhost:8000) and backend selection (`adk` for the local server;
# empty infers from configured variables):
AGENT_ADK_BASE_URL=
AQA_BACKEND=
# Unsupported: rejected at runtime because callers reach the chat agent over A2A
# through the target above:
AGENT_A2A_BASE_URL=
# Directory containing pre-built dashboard frontend assets (empty defaults to `ui/static_v2`):
AQA_STATIC_V2_DIR=

# --- Tests and local dev scripts ---
# Set to 1 by the test suites and by several dev scripts in `quality/` and
# `tools/`, so a local `.env` does not change their runs.
# Empty keeps python-dotenv enabled.
PYTHON_DOTENV_DISABLED=
