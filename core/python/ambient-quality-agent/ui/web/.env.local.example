# The app itself reads no environment variable: every request is same-origin,
# and the agent card's advertised URLs are rewritten to /a2a before the client
# is built. This file configures the Vite dev server, nothing else.

# Where `npm run dev` forwards /api, /lha, /a2a, /feedback and /.well-known.
# vite.config.ts defaults to this same value, so copying this file is only
# needed to point the dev server somewhere else.
NEXT_PUBLIC_LHA_URL=http://127.0.0.1:8080
