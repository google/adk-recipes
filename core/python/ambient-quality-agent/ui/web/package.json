{
  "name": "aqua-web2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "format": "npx --yes @biomejs/biome@2.5.10 format --css-formatter-enabled=false --write .",
    "format:check": "npx --yes @biomejs/biome@2.5.10 format --css-formatter-enabled=false .",
    "lint": "npx --yes @biomejs/biome@2.5.10 lint --css-linter-enabled=false --error-on-warnings .",
    "check": "tsc --noEmit && vitest run && npm run format:check && npm run lint"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^0.454.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.9",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/router-plugin": "^1.168.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6"
  }
}
