# Copy to .env and fill in. `make dev-backend` loads it (set -a; . ./.env; set +a).
# Never commit real secrets — .env is gitignored; this template is not.
# Full variable catalog (every var + dependency extra): docs/configuration.md
# Grouped by subsystem below; all routes mount unconditionally.

# ---- Core / Vertex: required for any chat (model inference always uses Vertex) ----
# leave blank to use your active gcloud config project (make dev fills it in)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# ---- Recommended for a low-friction first run (local-first; see docs/quickstart.md) ----
# Gemini needs no Model Garden enablement step:
LHA_ROOT_MODEL=gemini-3.7-flash
# Run tools on the host instead of a Vertex sandbox (no sandbox image needed):
LHA_ENVIRONMENT_BACKEND=local
# Keep sessions in-process (no Agent Engine / Cloud SQL needed):
USE_IN_MEMORY_SESSION=true

# ---- Auth (local dev defaults; no IAP needed locally) ----
LHA_AUTH_MODE=dev
LHA_DEV_USER_ID=dev@local

# ---- Optional: Vertex sandbox backend (only if LHA_ENVIRONMENT_BACKEND=sandbox) ----
# e.g. us-central1-docker.pkg.dev/<project>/lha-sandbox/runtime:vX.Y.Z
LHA_RUNTIME_IMAGE=
# e.g. <service-account-email>
LHA_SANDBOX_CALLER_SA=
# LHA_SANDBOX_LOCATION=us-central1
# Sandbox outbound internet. Defaults to ON in local dev and OFF (hermetic) when
# deployed (Cloud Run sets K_SERVICE). Set explicitly to override either way.
# LHA_SANDBOX_INTERNET_ACCESS=0

# ---- Optional: model tuning ----
# Pin Gemini to Vertex's priority service tier (off by default; needs a Vertex entitlement):
# set to `priority` to use Vertex's priority tier (needs an entitlement)
LHA_VERTEX_SERVICE_TIER=

# ---- Optional: scheduler (reminders / routines / dream-review durability) ----
# Needs lha[scheduler]:
# LHA_ROUTINE_STORE=postgres
# e.g. postgresql://...
LHA_REMINDER_DB_URL=

# ---- Optional: "Connect Google" buttons (set to enable; a stored token is injected regardless) ----
LHA_GCP_OAUTH_CLIENT_ID=
LHA_GCP_OAUTH_CLIENT_SECRET=
# e.g. https://<web-host>/lha/gcp/callback
LHA_GCP_OAUTH_REDIRECT_URI=

# ---- Declared for completeness: every var the code reads ----
# Values below are the code defaults; blank means "unset" and the code treats it
# as such. Overriding one here changes behaviour.

# Agent Engine / Memory Bank (blank = in-memory session + no Memory Bank)
AGENT_ENGINE_RESOURCE_NAME=
AGENT_ENGINE_LOCATION=
AGENT_ENGINE_SESSION_NAME=
LHA_MEMORY_BANK_RESOURCE_NAME=
CODE_SANDBOX_RESOURCE_NAME=

# Persistence (blank = in-memory; set to a Postgres URL to persist)
SESSION_DB_URL=
TASK_DB_URL=
ARTIFACT_SERVICE_URI=
LOGS_BUCKET_NAME=

# Serving / auth
APP_URL=
ALLOW_ORIGINS=
LHA_IAP_AUDIENCE=
K_SERVICE=

# Sandbox backend
LHA_SANDBOX_LOCATION=
LHA_SANDBOX_ENGINE_NAME=
LHA_SANDBOX_TTL=
LHA_RUNTIME_MIN_VERSION=
LHA_LOCAL_ROOT=
SANDBOX_WORKSPACE=
SANDBOX_EXEC_TIMEOUT_SEC=

# Snapshot survival (off unless LHA_SNAPSHOT_ENABLED=1)
LHA_SNAPSHOT_TTL=
LHA_SNAPSHOT_KEEP=

# Scheduler (Cloud Scheduler -> /scheduler/*)
LHA_SCHEDULER_SA=
LHA_SCHEDULER_AUDIENCE=

# Telemetry / build metadata
GENAI_TELEMETRY_PATH=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=
AGENT_VERSION=
COMMIT_SHA=

# Test gates
RUN_SANDBOX_PROBE=

# Cloud trace export (needs ADC). Defaults on only when deployed.
LHA_OTEL_TO_CLOUD=
