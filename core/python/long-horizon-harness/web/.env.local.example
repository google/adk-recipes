# URL of the running lha FastAPI server (started via `make dev-backend` from repo root)
NEXT_PUBLIC_LHA_URL=http://127.0.0.1:8001

# App name used in the A2A app path (matches app/agent.py App(name=...))
NEXT_PUBLIC_LHA_APP_NAME=app

# Public source-repo URL for the header "Repo" button (button hides when unset)
VITE_REPO_URL=
