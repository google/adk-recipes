# ADK Voice Agent configuration. Copy this file to .env (`make onboard` does it for you).
# docs/configuration.md describes every variable.
#
# Every variable the code reads is declared here, with its default value. A blank value
# means "unset" (optional or deployment-specific), and `make deploy` skips blank keys.

# --- Google Cloud ----------------------------------------------------------------
# Vertex AI with ADC; there is no API-key mode.
GOOGLE_GENAI_USE_ENTERPRISE=true
# Deprecated name of the above, still honored (with a warning) when it is unset.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
# Where Gemini models are called. Keep global: the text models are served there.
GOOGLE_CLOUD_LOCATION=global
# Where the Live model (LIVE_MODEL) is called. Live models are regional, so it is pinned
# apart from GOOGLE_CLOUD_LOCATION.
LIVE_MODEL_LOCATION=us-central1

# --- Voice agent -----------------------------------------------------------------
# Voice and timezone are defaults; each user's own choices in the app are saved per
# user in the thread database.
LIVE_MODEL=gemini-3.8-live
GROUNDING_MODEL=gemini-3.5-flash-lite
LIVE_VOICE_NAME=Aoede
# native | cascaded (each user can pick their own in Settings)
VOICE_MODE=native
# Cascaded voice: speech-to-text, text model, text-to-speech.
CASCADE_STT_MODEL=gemini-3.5-transcribe-live
CASCADE_LLM_MODEL=gemini-3.5-flash-lite
CASCADE_TTS_MODEL=gemini-3.8-flash-tts
# IANA timezone for calendar answers (default: the system's)
USER_TIMEZONE=

# --- Coding harnesses and the computers ------------------------------------------
# claude | antigravity (the deployment default; each user can pick their own)
CODING_HARNESS=claude
# Threads one user can have running at once (the server-wide cap is 20)
MAX_RUNNING_THREADS_PER_USER=3
# Where each user's computer runs: host (this machine, one directory per user;
# development only), docker (the computer image in a local container per user),
# static (computers at COMPUTER_URL_TEMPLATE / COMPUTER_URL), or gce (a VM and disk per user)
COMPUTER_PROVIDER=host
# docker: the computer image (sandbox/Dockerfile) to run
COMPUTER_IMAGE=
# static: a per-user daemon URL with an {owner} placeholder, or one URL for everyone
COMPUTER_URL_TEMPLATE=
COMPUTER_URL=
# gce: the instance template (name or self link), zone, home disk size (GB),
# the computers' service account (default: the template's), and an optional snapshot
# schedule policy attached to new home disks. `make deploy` sets them.
COMPUTER_INSTANCE_TEMPLATE=
COMPUTER_ZONE=
COMPUTER_DISK_GB=50
COMPUTER_SERVICE_ACCOUNT=
COMPUTER_SNAPSHOT_POLICY=
# gce: the deployment the computers belong to (terraform's service_name).
# Names them <deployment>-u-<hash> and labels them deployment=<deployment>.
COMPUTER_DEPLOYMENT=adk-voice-agent
# gce: the audience of the IAP-protected app, for the daemon's MCP relay
COMPUTER_MCP_AUDIENCE=
# docker and gce: stop a computer after this many idle minutes (0 never stops)
COMPUTER_IDLE_STOP_MIN=20
# docker and gce: warm hours, when computers stay on and start at the window's open so the
# first request of the day doesn't wait for a boot, in each user's own timezone.
# off turns them off.
COMPUTER_WARM_HOURS=08:00-18:00
# Days the warm window opens on (e.g. mon-fri, mon-sun, mon,wed,fri)
COMPUTER_WARM_DAYS=mon-fri
# IANA timezone for the warm hours of users who haven't set theirs
COMPUTER_TIMEZONE=America/Chicago
# Optional dotfiles repo cloned into each new computer's home (docker and gce)
DOTFILES_REPO=
# Project and location for model calls made on the computer (Vertex AI)
# (default project: GOOGLE_CLOUD_PROJECT; location is global, never GOOGLE_CLOUD_LOCATION)
SANDBOX_GCP_PROJECT=
SANDBOX_GCP_LOCATION=global
# System 1's service account, the caller gce computers accept
# (default: <service_name>@<project>.iam.gserviceaccount.com)
SANDBOX_CALLER_SA=
# Read by the daemon in the computer image (sandbox/server.py; default /workspace,
# the image sets /home/agent)
SANDBOX_WORKSPACE=
# Computer daemon caller auth (sandbox/server.py; off by default for a local
# daemon). When on, requests need a Google ID token for the audience, issued to one
# of the comma-separated caller service accounts. System 1 mints its tokens for
# COMPUTER_AUTH_AUDIENCE too.
COMPUTER_REQUIRE_AUTH=
COMPUTER_AUTH_AUDIENCE=adk-voice-agent-computer
COMPUTER_ALLOWED_CALLERS=
# Read by the computer image (set by the provider): where the daemon's MCP relay
# forwards harness traffic (COMPUTER_MCP_AUDIENCE above adds IAP credentials).
COMPUTER_MCP_UPSTREAM=
# Base URL of the MCP bridge for environments without a relay (the host provider;
# default APP_URL), and a fixed bearer token the bridge accepts locally as the dev user
VOICE_AGENT_MCP_BASE_URL=
VOICE_AGENT_MCP_DEV_TOKEN=

# Claude Code on Vertex AI
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=global
# Default: GOOGLE_CLOUD_PROJECT
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5
ANTHROPIC_SMALL_FAST_MODEL=
# The `opus` alias and Claude Code's subagents (default: ANTHROPIC_MODEL)
ANTHROPIC_DEFAULT_OPUS_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
VERTEX_REGION_CLAUDE_HAIKU_4_5=
VERTEX_REGION_CLAUDE_4_6_SONNET=

# Antigravity CLI (`agy models` lists the options)
ANTIGRAVITY_MODEL=gemini-4-argon
# low | medium | high
ANTIGRAVITY_EFFORT=medium
# agy's sign-in: Application Default Credentials; see docs/configuration.md
AGY_ADC_AUTH=1

# Identity on agent commits
GIT_AUTHOR_NAME=ADK Voice Agent
GIT_AUTHOR_EMAIL=voice-agent@users.noreply.github.com
GIT_COMMITTER_NAME=ADK Voice Agent
GIT_COMMITTER_EMAIL=voice-agent@users.noreply.github.com

# --- Connected apps --------------------------------------------------------------
# Registered for this deployment by `make onboard`, which writes these keys here;
# `make deploy` copies them to Secret Manager (one secret per key) for Cloud Run. An app
# whose keys are blank isn't offered. Users connect them in the app (Settings → Apps).

# Google (Calendar, Gmail, Drive, Docs, Sheets, Slides): the OAuth client (Web
# application) users sign in with. It must belong to GOOGLE_CLOUD_PROJECT, where
# terraform enables the Google APIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub: the GitHub App `make onboard` creates; users connect by installing it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's URL name (github.com/apps/<slug>)
GITHUB_APP_SLUG=
# Optional GitHub organization to create the App under during `make onboard`
GITHUB_ORG=

# Written for you locally when you connect an app (deployed, each user's are kept in
# their own Secret Manager secret): tokens, which client issued the grant, the scopes
# it holds, and the connected account.
GOOGLE_WORKSPACE_ACCESS_TOKEN=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_TOKEN_SOURCE=
GOOGLE_WORKSPACE_GRANTED_SCOPES=
GOOGLE_WORKSPACE_ACCOUNT=
GITHUB_ACCESS_TOKEN=
GITHUB_REFRESH_TOKEN=
GITHUB_ACCOUNT=

# --- Server and storage ----------------------------------------------------------
# Threads, settings, and ADK sessions. Default: SQLite under ~/.adk-voice-agent. Or
# postgresql+asyncpg://user:pass@host/db (falls back to DATABASE_URL, then SESSION_DB_URL)
THREAD_DB_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
SQL_DEBUG=
# The Agent Engine holding Memory Bank, as its full resource name. `make onboard` sets
# it from terraform (terraform/memory.tf); `make deploy` sets it on the service.
# Without it, memory is off.
GOOGLE_CLOUD_AGENT_ENGINE_ID=
# The engine's region, only for an ID that isn't a full engine name; never
# GOOGLE_CLOUD_LOCATION, which is global.
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=
# Model that writes the recap of each conversation ADK Voice Agent remembers (default:
# GROUNDING_MODEL's value)
MEMORY_MODEL=
# A conversation that ended this many minutes ago carries its last turns into the next
# one, so a dropped connection picks up where it left off (0 turns it off)
VOICE_AGENT_CARRYOVER_MINUTES=10
# ADK artifacts in this GCS bucket (default: in memory)
LOGS_BUCKET_NAME=
# Public base URL for OAuth redirects; required when deployed
APP_URL=
# Comma-separated CORS origins (default: the local dev origins)
ALLOW_ORIGINS=
# Built UI the server serves
VOICE_AGENT_WEB_DIST=web/dist
# Address uvicorn binds to; a loopback value turns on the DNS-rebinding guard (`make dev` sets it)
VOICE_AGENT_BIND_HOST=
# Extra Host names a non-loopback local server answers to, comma-separated (e.g. a LAN IP)
VOICE_AGENT_ALLOWED_HOSTS=
# Who a request runs as: dev (one local user, refused when deployed) or iap
VOICE_AGENT_AUTH_MODE=dev
# The user id in dev mode
VOICE_AGENT_DEV_USER_ID=local
# iap mode: the audience IAP signs, /projects/<number>/locations/<region>/services/<name> (`make deploy` sets it)
VOICE_AGENT_IAP_AUDIENCE=
# Where each user's connected-app tokens live: auto (Secret Manager secret
# <service_name>-user-<hash> per user when deployed, this .env locally), env, or secret_manager
VOICE_AGENT_CREDENTIAL_STORE=auto
# Thread database and other local state (default: ~/.adk-voice-agent)
VOICE_AGENT_STATE_DIR=
# Where COMPUTER_PROVIDER=host keeps each user's directory (default: <tmp>/adk-voice-agent-workspaces)
VOICE_AGENT_WORKSPACE_ROOT=
VOICE_AGENT_WORKSPACES_LOCAL_YAML=config/workspaces.local.yaml
# 1 skips the startup Google Workspace token refresh
VOICE_AGENT_SKIP_STARTUP_WARMUP=

# --- Shell only ------------------------------------------------------------------
# Read before this file is loaded, so they only work in the process environment:
#   VOICE_AGENT_DOTENV_PATH=<path>  load a different .env
#   VOICE_AGENT_LOAD_DOTENV=0       skip .env entirely, including ADK's own loader
VOICE_AGENT_DOTENV_PATH=
VOICE_AGENT_LOAD_DOTENV=1

# --- Set for you; leave blank ----------------------------------------------------
# Cloud Run sets these, which turns on remote mode.
K_SERVICE=
CLOUD_RUN_JOB=
# The thread's working directory, set on each harness run.
VOICE_AGENT_THREAD_CLONE=
