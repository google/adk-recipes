# retail-virtual-tryon — all configuration in one place.
#
# Copy this file to `.env` and edit values. Every script reads from `.env`
# via `scripts/config.py` (which calls `load_dotenv()` once at import).
#
# Q-MODE users: after running the skill's Q-MODE interview, `setup.py` writes
# your answers into `.env` automatically — you don't need to edit this file
# by hand.

# --- GCP project & region ---
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
GCP_REGION=us-west1

# Gemini Enterprise Agent Platform serves Gemini image models at `global`.
# Do not change unless you know your project has regional image-model
# endpoints.
GEMINI_MODEL_LOCATION=global

# --- Models ---
# Image try-on model. Only gemini-2.5-flash-image and gemini-2.5-pro-image
# are currently published in Gemini Enterprise Agent Platform.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ADK agent LLM (scripts/tryon_agent.py).
GEMINI_MODEL=gemini-3.5-flash

# Catalog classifier LLM (scripts/scan_catalog.py).
GEMINI_TEXT_MODEL=gemini-3.5-flash

# --- GCS buckets ---
# Bucket for generated try-on outputs. Convention: <project>-tryon-output.
TRYON_OUTPUT_BUCKET=<YOUR_PROJECT_ID>-tryon-output

# Bucket for ephemeral user photo uploads. 24-hour auto-delete is configured
# by setup_tryon.py.
TRYON_UPLOAD_BUCKET=<YOUR_PROJECT_ID>-tryon-uploads

# --- Catalog ---
# Local directory or gs:// URI containing product images.
TRYON_CATALOG_PATH=catalog_images

# --- Runtime ---
# Local sandbox port.
PORT=8080

# --- Container & Agent Engine serving ---
AGENT_VERSION=0.1.0
ALLOW_ORIGINS=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
INTEGRATION_TEST=0
LOGS_BUCKET_NAME=
SESSION_SERVICE_URI=
