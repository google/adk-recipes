# Copy to .env and fill in.

# --- Model access (pick ONE) ---
# Option A: Gemini API key (simplest for local dev)
GOOGLE_API_KEY=

# Option B: Vertex AI (uncomment and set instead of GOOGLE_API_KEY)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Model selection (defaults to gemini-3.5-flash)
MODEL_NAME=gemini-3.5-flash

# --- ClauseIQ runtime config (all optional; sensible local defaults) ---
CLAUSE_AGENT_MODEL=gemini-3.5-flash
CLAUSE_AGENT_CONFIDENCE_THRESHOLD=0.90
CLAUSE_AGENT_CONTRACTS_DIR=./clause_agent/data/contracts
CLAUSE_AGENT_MEMORY_PATH=./clause_agent_memory.json
CLAUSE_AGENT_AUDIT_LOG_PATH=./clause_agent_audit_log.jsonl
CLAUSE_AGENT_LEGAL_QUEUE_PATH=./clause_agent_legal_queue.json
