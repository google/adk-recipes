# Model Configuration
MODEL_NAME=gemini-3.7-flash

# Code to fix. Empty = the bundled, intentionally vulnerable app/sample_target.
# The directory is copied to a temporary working copy and never modified.
# Example: TARGET_DIR=/path/to/your/python/repo
TARGET_DIR=

# Test command run in the working copy (no shell). Empty = stdlib unittest
# discovery under tests/. For pytest projects use -rA so per-test results are
# reported. Example: TEST_COMMAND=python -m pytest -rA -q
TEST_COMMAND=

# Bandit checks to skip (comma separated). These flag API usage rather than a
# vulnerability, so a correct fix is not reported as a new finding.
BANDIT_SKIPS=B101,B404,B603,B607

# Detect -> patch -> validate loop configuration
MAX_PATCH_ATTEMPTS=8
VALIDATION_TIMEOUT_SECONDS=120

# Google Cloud Platform Configuration (for Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=<TODO: update-this-value>

# Telemetry and Logging Configuration
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# GENAI_TELEMETRY_PATH=completions
# COMMIT_SHA=dev
LOGS_BUCKET_NAME=

# Serving Configuration (used by the generated fast_api_app.py / app_utils).
# Empty values fall back to local, in-memory defaults.
AGENT_VERSION=0.1.0
ALLOW_ORIGINS=
APP_URL=http://127.0.0.1:8080
SESSION_SERVICE_URI=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
INTEGRATION_TEST=
