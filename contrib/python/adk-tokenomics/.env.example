# Google Cloud & BigQuery Configuration
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT=
BIGQUERY_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
CLOUD_RUN_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# BigQuery Telemetry Dataset, Table & View (defaults to bq_adk_ds / adk_agent_events / v_llm_response when empty)
BQ_ANALYTICS_DATASET_ID=
BQ_ANALYTICS_TABLE_ID=
BQ_ANALYTICS_VIEW_ID=

# Tokenomics SDK Runtime & Baseline Model Configuration
TOKENOMICS_MODE=dev
TOKENOMICS_SINK=memory
TOKENOMICS_DEFAULT_MODEL=gemini-3.8-flash
TOKENOMICS_FRONTIER_MODEL=gemini-4-argon
TOKENOMICS_APP_NAME=
TOKENOMICS_AUTO_EXPORT_PATH=
TOKENOMICS_MODELS_CONFIG_PATH=
TOKENOMICS_MODELS_CONFIG=
TOKENOMICS_ALLOWED_HOSTS=
TOKENOMICS_DEV_RELOAD=
PORT=8080

# Optional OS / Container Runtime Overrides (leave empty by default)
K_SERVICE=
XDG_CONFIG_HOME=
