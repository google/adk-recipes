# Model Configuration
MODEL_NAME=gemini-3.7-flash

# How many times the workflow sends an invalid parsed request back to the
# parser (with the validation errors) before replying with help.
PARSE_RETRY_LIMIT=1

# Google Cloud Platform Configuration (for Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=your-api-key

# Forecast data source (all three read raw ensemble members):
#   snapshot      bundled real ECMWF AIFS ENS forecast (no credentials)
#   aifs_ens      ECMWF AIFS ENS live from dynamical.org (public; Python 3.12+)
#   weathernext_3 WeatherNext 3 ensemble Zarr on Cloud Storage (allowlisted
#                 Google account + Application Default Credentials)
FORECAST_SOURCE=snapshot
# Pin a forecast init time (UTC, ISO 8601) for the live sources, e.g.
# 2026-10-20T06:00:00Z. Empty = newest complete 6-hourly init.
FORECAST_INIT_TIME=
# Maximum forecast lead time to load, in hours (up to 360).
FORECAST_MAX_LEAD_HOURS=168
# Public Icechunk store of ECMWF AIFS ENS (https://dynamical.org/catalog/ecmwf-aifs-ens-forecast/).
AIFS_ENS_ICECHUNK_URL=https://dynamical-ecmwf-aifs-ens.s3.us-west-2.amazonaws.com/ecmwf-aifs-ens-forecast/v0.1.0.icechunk
# WeatherNext 3 64-member ensemble store: a folder of per-init stores (the
# public layout below) or a single .zarr store you have been given access to.
WEATHERNEXT_ZARR_URI=gs://weathernext3_spatial/weathernext_3_0_0/zarr/2026_to_present
# Google Cloud project billed for Requester Pays reads. Empty = none.
WEATHERNEXT_BILLING_PROJECT=

# Your own sites and point snapshot (same format as app/data/forecast_snapshot.json).
# Empty = bundled files in app/data/.
SITES_JSON=
FORECAST_SNAPSHOT_JSON=

# Planning assumptions (see app/config.py). Empty TASK_LIMITS_JSON = defaults.
# Example: TASK_LIMITS_JSON={"main_component_lift": {"max_wind_ms": 9.0}}
TASK_LIMITS_JSON=
GUST_FACTOR=1.35
SHEAR_EXPONENT=0.14

# Telemetry and Logging Configuration
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# GENAI_TELEMETRY_PATH=completions
# COMMIT_SHA=dev
LOGS_BUCKET_NAME=

# Serving Configuration (used by the generated fast_api_app.py / app_utils).
# Empty values fall back to local, in-memory defaults.
AGENT_VERSION=0.1.0
ALLOW_ORIGINS=
APP_URL=http://127.0.0.1:8080
SESSION_SERVICE_URI=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
INTEGRATION_TEST=
