# Model Configuration
MODEL_NAME=gemini-3.7-flash

# Google Cloud Platform Configuration (for Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=your-api-key

# Forecast data source: "sample" (bundled synthetic ensemble) or "bigquery"
# (WeatherNext 3 statistics via the BigQuery Analytics Hub listing).
WEATHERNEXT_SOURCE=sample
# Full id of the linked WeatherNext table (bigquery source only).
# Example: WEATHERNEXT_BQ_TABLE=my-project.weathernext.weathernext_3_0_0_0p1deg
WEATHERNEXT_BQ_TABLE=
# Project billed for BigQuery queries. Empty = the client's default project.
WEATHERNEXT_BQ_PROJECT=
# Pin a forecast init time (UTC, ISO 8601), e.g. 2026-10-12T00:00:00Z.
# Empty = latest 6-hourly init in the last 2 days.
WEATHERNEXT_INIT_TIME=
# Maximum forecast lead time to load, in hours (up to 360 for 6-hourly inits).
WEATHERNEXT_MAX_HOURS=120
# Seconds before a BigQuery query is abandoned (client) and stopped (server).
WEATHERNEXT_BQ_TIMEOUT_SECONDS=60

# Your own sites and member-level forecast file. Empty = bundled samples in app/data/.
SITES_JSON=
SAMPLE_FORECAST_JSON=

# Planning assumptions (see app/config.py). Empty TASK_LIMITS_JSON = defaults.
# Example: TASK_LIMITS_JSON={"main_component_lift": {"max_wind_ms": 9.0}}
TASK_LIMITS_JSON=
GUST_FACTOR=1.35
SHEAR_EXPONENT=0.14

# Telemetry and Logging Configuration
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# GENAI_TELEMETRY_PATH=completions
# COMMIT_SHA=dev
LOGS_BUCKET_NAME=

# Serving Configuration (used by the generated fast_api_app.py / app_utils).
# Empty values fall back to local, in-memory defaults.
AGENT_VERSION=0.1.0
ALLOW_ORIGINS=
APP_URL=http://127.0.0.1:8080
SESSION_SERVICE_URI=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
INTEGRATION_TEST=
