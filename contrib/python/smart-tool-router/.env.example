# smart-tool-router — agent and SmartRouterPlugin configuration.
#
# Copy this file to `.env` and edit values. Every module reads from `.env`
# via `app/config.py`.

# --- GCP project & region ---
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
GOOGLE_CLOUD_LOCATION=us-central1

# --- Models (pin explicit GA model IDs for controlled GCP environments) ---
# Update MODEL_NAME and SMART_ROUTER_EMBEDDING_MODEL to match your project's
# approved Gemini Enterprise models (e.g., gemini-3.7-flash, gemini-3.8-flash,
# gemini-embedding-2, or gemini-embedding-001).
GEMINI_MODEL=gemini-3.7-flash
MODEL_NAME=gemini-3.7-flash
SMART_ROUTER_EMBEDDING_MODEL=gemini-embedding-2

# --- Smart Router & BigQuery Agent Analytics ---
SMART_ROUTER_MODE=off
SMART_ROUTER_ROUTE_FRACTION=0.0
SMART_ROUTER_HOLDOUT_FRACTION=0.05
SMART_ROUTER_JUDGES=prototype
SMART_ROUTER_BQ_PROJECT=
SMART_ROUTER_BQ_DATASET=smart_router
SMART_ROUTER_GCS_BUCKET=

# --- Container & Agent Engine serving ---
AGENT_VERSION=1.0.0
ALLOW_ORIGINS=http://127.0.0.1:8080
APP_URL=http://127.0.0.1:8080
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=True
INTEGRATION_TEST=
LOGS_BUCKET_NAME=
SESSION_SERVICE_URI=
PORT=8080
