# Model Configuration
MODEL_NAME=gemini-3.5-flash

# Credentials: uncomment exactly one of the two blocks below. With neither
# filled in the agent cannot reach Gemini, and `cp .env.example .env` alone
# is not enough (see the Setup section of README.md).

# Google Cloud Platform Configuration (for Vertex AI)
# GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=<TODO: update-this-value>

# Web Server Configuration
# Comma-separated CORS origins for `uvicorn app.fast_api_app:app`, e.g.
# http://localhost:3000,http://localhost:8080. Blank keeps ADK's default.
ALLOW_ORIGINS=

# Telemetry and Logging Configuration
# The values below are the ones the code already falls back to, so the file is
# complete as shipped. There are two independent channels here, and only the
# first is controlled from this file:
#
#   1. Prompt-response upload to GCS -- off until you name a bucket below.
#   2. Cloud Trace / Metrics / Logging export -- NOT gated by this file, and no
#      variable here turns it off. app/fast_api_app.py passes
#      otel_to_cloud=project_id is not None, so `uvicorn app.fast_api_app:app`
#      starts exporting as soon as google.auth.default() resolves a project --
#      i.e. for anyone who has run `gcloud auth application-default login`,
#      with every variable below left blank. Unset those credentials, or use
#      `adk run app` / `python -m app.walkthrough`, to keep it off.
#
# GCS bucket for ADK artifacts and GenAI telemetry uploads. Must stay blank
# unless the bucket exists -- any non-empty value is read as "GCS storage is
# enabled" and becomes gs://<value>. Nothing checks that the bucket is real:
# the client is built lazily, so a placeholder here buys a server that starts
# and then fails on the first artifact write.
LOGS_BUCKET_NAME=
# Prompt-response logging: `false` keeps it off; NO_CONTENT (with a bucket)
# logs metadata only, never prompts or responses.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# Prefix under the bucket that uploaded completions are written to.
GENAI_TELEMETRY_PATH=completions
# Build identifier reported as service.version on exported traces.
COMMIT_SHA=dev
# Applied by telemetry.py via os.environ.setdefault once logging is on;
# uncomment only to override.
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Widget rendering
# Nothing to configure. Widgets are emitted on ADK's UiWidget channel with
# provider "a2ui"; whether they are drawn is up to the host. `adk run app`
# prints replies only, so use `python -m app.walkthrough` to see the A2UI
# payloads themselves.
