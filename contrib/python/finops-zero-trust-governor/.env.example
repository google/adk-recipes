# Google Cloud / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# BigQuery Billing & Cloud Trace Configuration
FINOPS_BQ_BILLING_TABLE=<TODO: update-this-value>
FINOPS_COST_SPIKE_THRESHOLD_USD=250.0
FINOPS_MAX_LLM_TURNS_PER_RUN=12

# Zero-Trust Mid-Task Revocation Configuration (Issue #2769)
ZERO_TRUST_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
ZERO_TRUST_ENFORCE_REVOCATION=TRUE

# Test Seam: Set to TRUE in CI / local pytest to use deterministic mocks without GCP credentials
INTEGRATION_TEST=TRUE

# Container & Deployment Configuration
AGENT_VERSION=0.1.0
ALLOW_ORIGINS=http://localhost:8080
APP_URL=http://localhost:8080
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
LOGS_BUCKET_NAME=
SESSION_SERVICE_URI=
