# Copy to .env and fill in values for your environment.
# Also see plugins/retail/skills/virtual-tryon for the companion agent skill.

# Route google-genai calls through Gemini Enterprise Agent Platform rather than the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Required: GCP project that owns Gemini Enterprise Agent Platform and GCS buckets.
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>

# Region for Cloud Storage and default Gemini Enterprise Agent Platform calls.
GCP_REGION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1

# Region specifically for Gemini image/video models ("global" recommended for preview image models).
GEMINI_MODEL_LOCATION=global

# Image generation model for virtual try-on ("gemini-2.5-flash-image" or "gemini-2.5-pro-image").
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_PRO_IMAGE_MODEL=gemini-2.5-pro-image

# Video generation model for catwalk animation.
VEO_VIDEO_MODEL=veo-3.1-generate-001

# Agent orchestration model.
GEMINI_MODEL=gemini-3.5-flash
MODEL_NAME=gemini-3.5-flash

# Optional: GCS bucket to store generated try-on images and videos.
# Leave unset to write outputs locally under tmp/vto-outputs/.
TRYON_OUTPUT_BUCKET=

# Optional: GCS bucket for temporary user photo uploads.
TRYON_UPLOAD_BUCKET=

# Container & Agent Engine serving
AGENT_VERSION=0.2.0
ALLOW_ORIGINS=http://127.0.0.1:8080
APP_URL=http://127.0.0.1:8080
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
INTEGRATION_TEST=
LOGS_BUCKET_NAME=
SESSION_SERVICE_URI=
PORT=8080

# Surfacing boolean flags (choose which targets `make surface` runs)
DEPLOY_AGENT_ENGINE=true
PUBLISH_GEMINI_ENTERPRISE=true
PUBLISH_AGENT_GARDEN=true
DEPLOY_CLOUD_RUN=false
RUN_LOCAL_WEB=false

# Optional Gemini Enterprise App ID (required when PUBLISH_GEMINI_ENTERPRISE=true)
GEMINI_ENTERPRISE_APP_ID=
