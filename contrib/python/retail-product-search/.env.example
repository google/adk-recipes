# retail-product-search — agent configuration and surfacing flags.
#
# Copy this file to `.env` and edit values. Every module reads from `.env`
# via `app/config.py`.

# --- GCP project & region ---
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
GOOGLE_CLOUD_LOCATION=global

# --- Gemini Enterprise Agent Platform Vector Search ---
VECTOR_SEARCH_LOCATION=us-central1
VECTOR_SEARCH_COLLECTION=

# --- Models ---
GEMINI_MODEL=gemini-3.5-flash
MODEL_NAME=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# --- Container & Agent Engine serving ---
AGENT_VERSION=0.2.0
ALLOW_ORIGINS=http://127.0.0.1:8080
APP_URL=http://127.0.0.1:8080
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True
INTEGRATION_TEST=
LOGS_BUCKET_NAME=
SESSION_SERVICE_URI=
PORT=8080

# --- Agent Surfacing Personas (boolean flags) ---
DEPLOY_AGENT_ENGINE=true
PUBLISH_GEMINI_ENTERPRISE=true
PUBLISH_AGENT_GARDEN=true
DEPLOY_CLOUD_RUN=false
RUN_LOCAL_WEB=false
