# =============================================================================
# GCP Configuration
# =============================================================================
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
PROJECT_NAME=multiformat-hybrid-rag
GOOGLE_CLOUD_LOCATION=us-central1
# Endpoint serving the Gemini models. The gemini-3.x family is published
# only on `global` and returns 404 from a regional endpoint, so this is
# deliberately separate from the data region above.
GOOGLE_CLOUD_LOCATION_MODELS=global

# =============================================================================
# GCS — Source of Truth
# =============================================================================
GCS_BUCKET=${GOOGLE_CLOUD_PROJECT}-rag-docs
GCS_PREFIX=documents/

# =============================================================================
# BigQuery — Metadata & Preprocessing
# =============================================================================
BQ_DATASET=rag_pipeline
BQ_OBJECT_TABLE=gcs_objects
BQ_PREPROCESSED_TABLE=preprocessed
BQ_CHUNKS_TABLE=chunks
BQ_GCS_CONNECTION_ID=rag-gcs-connection

# =============================================================================
# Vector Search 2.0
# =============================================================================
VS_COLLECTION_ID=${PROJECT_NAME}-collection
VS_DOCUMENTS_COLLECTION_ID=${PROJECT_NAME}-documents
VS_EMBEDDING_MODEL=gemini-embedding-001
VS_EMBEDDING_DIMS=3072
VS_BATCH_SIZE=250

# =============================================================================
# Gemini Models
# =============================================================================
MODEL_NAME=gemini-3.7-flash
MODEL_NAME_MCP_TOOL=gemini-3.5-flash-lite
MARKDOWN_CONVERTER_GEMINI_MODEL=gemini-3.7-flash
CONTEXTUAL_CHUNKING_GEMINI_MODEL=gemini-3.5-flash-lite
RELEVANCE_GEMINI_MODEL=gemini-3.5-flash-lite

# =============================================================================
# Vertex AI Pipelines
# =============================================================================
SERVICE_ACCOUNT=${PROJECT_NAME}-rag@${GOOGLE_CLOUD_PROJECT}.iam.gserviceaccount.com
PIPELINE_ROOT=gs://${GOOGLE_CLOUD_PROJECT}-${PROJECT_NAME}-pipeline/pipeline-root
PIPELINE_IMAGE=${GOOGLE_CLOUD_LOCATION}-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${PROJECT_NAME}-pipeline/data-pipeline:latest
PREPROCESS_SERVICE_IMAGE=${GOOGLE_CLOUD_LOCATION}-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${PROJECT_NAME}-pipeline/preprocess-service:latest
CHUNK_INDEX_SERVICE_IMAGE=${GOOGLE_CLOUD_LOCATION}-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${PROJECT_NAME}-pipeline/chunk-index-service:latest

# =============================================================================
# Pipeline Scheduling
# =============================================================================
PIPELINE_CRON="0 2 * * *"

# =============================================================================
# Search
# =============================================================================
VS_SEMANTIC_WEIGHT=0.7

# =============================================================================
# Chunking
# =============================================================================
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# =============================================================================
# Serving layer (agent, MCP, REST)
# =============================================================================
# Leave MCP_SERVER_URL empty to run the MCP server as a stdio subprocess.
# fast_api_app.py sets it automatically when serving the mounted SSE app.
MCP_SERVER_URL=
MCP_SERVER_PORT=8081
MCP_CONTEXT_WINDOW=10000
# Comma-separated CORS origins; empty disables the CORS middleware.
ALLOW_ORIGINS=
# ADK artifact bucket, created by Terraform and injected on Cloud Run.
LOGS_BUCKET_NAME=
# Set only for API-key auth; leave empty to use Vertex AI with ADC.
GOOGLE_API_KEY=

# =============================================================================
# Ingestion services — URLs injected by Terraform at deploy time
# =============================================================================
PREPROCESS_SERVICE_URL=
CHUNK_INDEX_SERVICE_URL=

# =============================================================================
# Ingestion services — tuning
# =============================================================================
PREPROCESS_MAX_WORKERS=200
PREPROCESS_FLUSH_BATCH_SIZE=100
PREPROCESS_HTTP_TIMEOUT=600
PREPROCESS_HTTP_RETRIES=4
CHUNK_INDEX_MAX_WORKERS=200
CHUNK_INDEX_FLUSH_BATCH_SIZE=1500
CHUNK_INDEX_DELETE_BATCH_SIZE=100
CHUNK_INDEX_HTTP_TIMEOUT=900
CHUNK_INDEX_HTTP_RETRIES=4
ENRICH_THREADS=16
MAX_FULL_DOC_CHARS=500000
WINDOW_PER_SIDE_CHARS=50000

# =============================================================================
# Pipeline
# =============================================================================
# Cloud Run services read REGION; the serving layer reads
# GOOGLE_CLOUD_LOCATION. Both resolve to the same region.
REGION=${GOOGLE_CLOUD_LOCATION}
PIPELINE_NAME=rag-ingestion
# NOTE: submit_pipeline.py reads CRON_SCHEDULE while the Makefile reads
# PIPELINE_CRON (above). Pre-existing mismatch, tracked separately — set
# both to the same value until it is resolved.
CRON_SCHEDULE="0 2 * * *"

# =============================================================================
# Cloud Run service names (used to resolve service URLs)
# =============================================================================
PREPROCESS_SERVICE_NAME=multiformat-hybrid-rag-preprocess
CHUNK_INDEX_SERVICE_NAME=multiformat-hybrid-rag-chunk-index

# =============================================================================
# Vector Search — full resource paths
#
# Leave empty to let the serving layer derive them from
# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION / VS_*_COLLECTION_ID above.
# The chunk-index Cloud Run service receives the resolved values from
# Terraform as VS_COLLECTION_PATH / VS_DOCUMENTS_COLLECTION_PATH.
# =============================================================================
VECTOR_SEARCH_COLLECTION=
VECTOR_SEARCH_DOCUMENTS_COLLECTION=
VS_COLLECTION_PATH=
VS_DOCUMENTS_COLLECTION_PATH=
