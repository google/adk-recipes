# Model Configuration
MODEL_NAME=gemini-3.5-flash

# Google Cloud Platform Configuration (for Vertex AI)
# GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=<TODO: update-this-value>

# Web Server and Telemetry Configuration (all optional; see app/fast_api_app.py
# and app/app_utils/telemetry.py). Blank means "unset" and the code applies
# its own local-dev-safe default — fill one in only if you're deploying with
# GCS-backed logging/tracing or need to override CORS/telemetry behavior.
# Setting LOGS_BUCKET_NAME to anything other than a real bucket name (e.g. a
# TODO placeholder) will break `uv run uvicorn app.fast_api_app:app`, since a
# non-empty value is treated as "GCS artifact storage is enabled."
ALLOW_ORIGINS=
LOGS_BUCKET_NAME=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=
GENAI_TELEMETRY_PATH=
COMMIT_SHA=
# OTEL_TO_CLOUD defaults to on when deployed (Cloud Run sets K_SERVICE) and
# off for local dev. Set explicitly to override either way.
OTEL_TO_CLOUD=
# K_SERVICE is set automatically by Cloud Run; leave unset locally.
K_SERVICE=
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://your-gcs-bucket-name/completions
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=cross-border-data-router,service.version=dev
