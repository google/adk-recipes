# ---------------------------------------------------------------------------
# Neo4j Database Configuration
#
# Defaults point at Neo4j's public, read-only companies demo database, so the
# recipe runs without provisioning anything. Replace them to target your own
# graph.
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j+s://demo.neo4jlabs.com
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# ---------------------------------------------------------------------------
# Model configuration
# ---------------------------------------------------------------------------
MODEL_NAME=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Google auth. Choose ONE of the two options below.
#
# Option 1 (default): Google AI (ML Developer) API.
#   Get a key at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=<TODO: update-this-value>

# Option 2: Vertex AI. Set GOOGLE_GENAI_USE_VERTEXAI=1 and fill these in.
# Only read when GOOGLE_GENAI_USE_VERTEXAI=1; leave as-is for the API-key path.
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
GOOGLE_CLOUD_LOCATION=<TODO: update-this-value>

# ---------------------------------------------------------------------------
# MCP Toolbox (optional)
#
# The investment_research_agent loads pre-validated queries from a running
# MCP Toolbox server. Leave this as the placeholder to fall back to the
# schema + Cypher tools. See the README for how to run the toolbox.
# ---------------------------------------------------------------------------
MCP_TOOLBOX_URL=<TODO: update-this-value>
