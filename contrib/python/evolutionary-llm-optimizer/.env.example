# Model Configuration
MODEL_NAME=gemini-3.7-flash

# Query engine: duckdb (default, runs on the bundled sample, no credentials)
# or bigquery (runs on a real BigQuery table; needs GOOGLE_CLOUD_PROJECT for
# billing and Application Default Credentials).
QUERY_ENGINE=duckdb
# BigQuery mode only. Table to optimize against, and a hard cap on the bytes
# any single query may bill (10 GiB here).
BIGQUERY_TABLE=bigquery-public-data.london_bicycles.cycle_hire
BIGQUERY_MAX_BYTES_BILLED=10737418240

# Evolution loop configuration
MAX_EVALUATIONS=8
POPULATION_SIZE=4
CANDIDATE_TIMEOUT_SECONDS=10

# Google Cloud Platform Configuration (for Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=<TODO: update-this-value>

# Telemetry and Logging Configuration
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# GENAI_TELEMETRY_PATH=completions
# COMMIT_SHA=dev
LOGS_BUCKET_NAME=

# Serving Configuration (used by the generated fast_api_app.py / app_utils).
# Empty values fall back to local, in-memory defaults.
AGENT_VERSION=0.1.0
ALLOW_ORIGINS=
APP_URL=http://127.0.0.1:8000
SESSION_SERVICE_URI=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
INTEGRATION_TEST=
