# Model Configuration
MODEL_NAME=gemini-3.5-flash

# Google Cloud Platform Configuration (Agent Platform, formerly Vertex AI)
# GOOGLE_CLOUD_PROJECT is also the project MCP requests are billed to.
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Cloud Billing export table in BigQuery: project.dataset.table
BILLING_TABLE=<TODO: update-this-value>

# Project to run the cost queries in (optional). Leave empty to use the
# project segment of BILLING_TABLE, which is where the export dataset lives.
BILLING_PROJECT=

# Serving configuration. Only read by the FastAPI server in app/fast_api_app.py
# (uvicorn and Cloud Run); `adk web` and `adk run` ignore all of these. The
# values below match the code's own defaults, so the file works as shipped.
# Comma-separated CORS origins. Blank keeps ADK's default.
ALLOW_ORIGINS=
# URL and version published in the A2A agent card.
APP_URL=http://0.0.0.0:8000
AGENT_VERSION=0.1.0
# Session storage. Blank for both uses in-memory sessions.
SESSION_SERVICE_URI=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
# Region of the Agent Engine above. Blank falls back to GOOGLE_CLOUD_LOCATION.
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=
# GCS bucket for artifacts. Blank keeps them in memory. Leave it blank unless
# the bucket exists, because any value is used as gs://<value>.
LOGS_BUCKET_NAME=
